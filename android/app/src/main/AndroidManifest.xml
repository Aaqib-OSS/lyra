<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- in-app updater (GitHub-release builds only; it switches itself off under F-Droid / Play): install the verified APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- lyric video recording: Spotify's sound is captured with the user's screen-recording consent (never the microphone) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- One APK for phones and TVs. Nothing below is required, so Google Play lists Lyra on phones, tablets and Android TV /
         Google TV: a TV has no touchscreen or microphone (RECORD_AUDIO above would otherwise imply a required microphone) and
         leanback is optional because the phone app does not need it. The TV launcher shows .tv.TvActivity (LEANBACK_LAUNCHER). -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- the lyric-video recorder is portrait-only, which Android would turn into a required "portrait screen" (no TV has one) -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <!-- lets Lyra open the Spotify app from its "Open in Spotify" button -->
    <queries>
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lyra">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>


        <receiver android:name=".update.UpdateInstallReceiver" android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Android TV / Google TV / Fire TV: the only activity a TV launcher shows (a TV screen is always landscape), remote-controlled. -->
        <activity
            android:name=".tv.TvActivity"
            android:banner="@drawable/tv_banner"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|navigation|keyboard"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Lyra.Tv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lyra as the TV's screen saver (black, low power; see docs/android-tv.md) -->
        <service
            android:name=".tv.TvDream"
            android:exported="true"
            android:label="@string/tv_dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>

        <!-- Holds the "notification access" permission that lets Lyra see what is playing. It never reads notifications. -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Switch for ambient mode: Quick Settings tile, home-screen widget, app-icon shortcut -->
        <service
            android:name=".AmbientTileService"
            android:exported="true"
            android:icon="@drawable/ic_ambient"
            android:label="Lyra ambient"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver android:name=".AmbientWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ambient_widget_info" />
        </receiver>
        <!-- The live lyrics widget: cover, current line, progress and controls, resizable -->
        <receiver
            android:name=".LyraWidget"
            android:exported="false"
            android:label="@string/lyra_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/lyra_widget_info" />
        </receiver>
        <receiver android:name=".LyraWidgetAction" android:exported="false" />
        <!-- More widgets: 2x1 mini player, 4x1 lyrics ticker, 1x1 play button, 2x2 cover art -->
        <receiver android:name=".LyraMiniWidget" android:exported="false" android:label="@string/lyra_widget_mini_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/lyra_widget_mini_info" />
        </receiver>
        <receiver android:name=".LyraTickerWidget" android:exported="false" android:label="@string/lyra_widget_ticker_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/lyra_widget_ticker_info" />
        </receiver>
        <receiver android:name=".LyraPlayWidget" android:exported="false" android:label="@string/lyra_widget_play_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/lyra_widget_play_info" />
        </receiver>
        <receiver android:name=".LyraCoverWidget" android:exported="false" android:label="@string/lyra_widget_cover_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/lyra_widget_cover_info" />
        </receiver>
        <receiver android:name=".LyraCardWidget" android:exported="false" android:label="@string/lyra_widget_card_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/lyra_widget_card_info" />
        </receiver>
        <receiver android:name=".LyraBigWidget" android:exported="false" android:label="@string/lyra_widget_big_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/lyra_widget_big_info" />
        </receiver>
        <receiver android:name=".LyraArtWidget" android:exported="false" android:label="@string/lyra_widget_art_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/lyra_widget_art_info" />
        </receiver>
        <!-- Opens when a widget is added (and from "reconfigure"): pick the widget's look -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Lyra.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AmbientToggleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Ambient (always-on-display style) lyrics screen -->
        <activity
            android:name=".AmbientActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Lyra" />

        <!-- Records a lyric video: the Lyra screen plus Spotify's sound, after the user allowed it -->
        <activity
            android:name=".RecordActivity"
            tools:targetApi="29"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Lyra" />
        <service
            android:name=".RecordService"
            tools:targetApi="29"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- Lyra as an Android screen saver (Settings > Display > Screen saver) -->
        <service
            android:name=".LyraDream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream" />
        </service>

        <!-- Live lyrics in the notification shade and on the lock screen -->
        <service
            android:name=".LyricsNotificationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the current lyric line in a notification while the user listens to music" />
        </service>
        <receiver android:name=".LyricsActionReceiver" android:exported="false" />

        <!-- Optional "Keep Lyra running" switch in Settings -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps synced lyrics ready while the user listens to music" />
        </service>

        <!-- Optional floating lyrics widget over other apps -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows a floating lyrics widget over other apps while the user listens to music" />
        </service>
    </application>
</manifest>
