<?xml version="1.0" encoding="utf-8"?>
<!-- 1 x 1: the dimmed cover with one big play / pause button -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/lw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />
        <ImageButton
            android:id="@+id/lw_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
        android:layout_gravity="center"
            android:background="@drawable/widget_btn_bg_main"
            android:contentDescription="Play or pause"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_w_play_dark" />
</FrameLayout>
