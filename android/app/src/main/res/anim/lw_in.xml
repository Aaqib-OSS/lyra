<?xml version="1.0" encoding="utf-8"?>
<!-- the new lyric line rises in and fades up (ViewFlipper in the 2x2 big-lyric widget) -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:duration="320" android:interpolator="@android:interpolator/decelerate_quad">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <translate android:fromYDelta="35%p" android:toYDelta="0" />
</set>
